import { Pay } from "@cashier_alipay/cashiersdk";
import { BridgeCallback } from "./CommonApi";
import { BusinessError } from "@kit.BasicServicesKit";
import { NumberUtil } from "@pura/harmony-utils";

export function RegisterAliApiManager(){
  let register:Record<string, object> = {}
  register["AliApiManager"] = AliApiManager;
  return register;
}

export default class AliApiManager{
  private static instance:AliApiManager;

  public static getInstance():AliApiManager{
    if (AliApiManager.instance == null) {
      AliApiManager.instance = new AliApiManager
    }
    return AliApiManager.instance;
  }

  /**
   * 支付宝支付
   * @param order 订单信息
   * @param callback 支付回调
   */
  public pay(order:string, callback:BridgeCallback){
    new Pay().pay(order, true).then(res =>{
      let resultStatus = res.get('resultStatus')
      let result = res.get('result')
      let memo = res.get('memo')
      if (resultStatus === "9000" || resultStatus === "8000" || resultStatus === "6004") {
        callback.success(result ? result : "")
      } else if (resultStatus === "6001") {
        callback.cancel()
      } else {
        callback.error(resultStatus ? -1 : NumberUtil.toInt(resultStatus), result ? result : "")
      }
    }).catch((error: BusinessError) => {
      console.log(error.message);
      callback.error(error.code, error.message)
    });
  }
}